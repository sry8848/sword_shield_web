{
  "name": "xihu-jian-frontend",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev:portal": "pnpm --filter @xhlj/portal dev",
    "dev:admin": "pnpm --filter @xhlj/admin dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test",
    "preview:portal": "pnpm --filter @xhlj/portal preview",
    "preview:admin": "pnpm --filter @xhlj/admin preview"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.0.0",
    "@playwright/test": "^1.55.0",
    "eslint": "^9.5.0",
    "typescript": "^5.9.0",
    "vue-tsc": "^3.0.0"
  }
}